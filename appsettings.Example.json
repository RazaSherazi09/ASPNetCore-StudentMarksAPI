{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=marks_db;Username=marks_user;Password=replace_with_your_database_password"
  },
  "Jwt": {
    "Issuer": "MarksApi",
    "Audience": "MarksApiClients",
    "Key": "replace-with-a-long-random-text-of-32-or-more-characters",
    "LifetimeMinutes": 60
  },
  "Grading": {
    "PassMark": 50
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "RateLimiting": {
    "LoginPermitLimit": 60,
    "LoginWindowSeconds": 60
  },
  "SmokeTest": {
    "TeacherUsername": "teacher1",
    "TeacherPassword": "replace-with-seeded-teacher-password",
    "StudentUsername": "student1",
    "StudentPassword": "replace-with-seeded-student-password",
    "OtherStudentId": 2
  }
}

